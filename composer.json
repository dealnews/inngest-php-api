{
    "name": "dealnews/inngest-api",
    "description": "Library for interacting with the Inngest API",
    "type": "library",
    "license": "BSD-3-Clause",
    "config": {
        "optimize-autoloader": true,
        "discard-changes": true,
        "sort-packages": true
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "DealNews\\InngestApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DealNews\\InngestApi\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "test-functional": "phpunit --testsuite functional",
        "lint": "parallel-lint src tests",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    }
}
